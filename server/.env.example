# These are set via: wrangler secret put <KEY>
# ADMIN_PASSWORD_HASH=<bcrypt hash of your password>
# JWT_SECRET=<random 64-char string>
# RESEND_API_KEY=<from resend.com>
# CONTACT_EMAIL=<your email address>

# R2 Bucket names (configure in wrangler.toml)
# DATA_BUCKET binding -> portfolio-data
# ASSETS_BUCKET binding -> portfolio-assets
